; =====================================================
; НАЧАЛО ПРОГРАММЫ LES2008.CNC
; G - код
; Изготовление изделий из проволоки
; =====================================================
G90 ;6 sec
; G90 - абсолютные координаты (все координаты отсчитываются от нуля)
; ;6 sec - комментарий: пауза 6 секунд (не выполняется)
M17
; M17 - ВКЛЮЧИТЬ ПРИВОДЫ (двигатели осей)
#7=21.0; koefficien podachi
; #7 = 21.0 - коэффициент подачи (множитель для расчёта длины)
; Комментарий: коэффициент подачи
#1=-17.10 ;ofset z
; #1 = -17.10 - смещение по оси Z (глубина погружения инструмента)
; Комментарий: offset Z
#11=25 ; rastoyanie provoloki
; #11 = 25 - базовое расстояние проволоки (начальная точка)
; Комментарий: расстояние проволоки
#2=0
; #2 = 0 - счётчик циклов (начинается с 0)
; Будет увеличиваться на 1 после каждого изделия
#3=500 ;number chebur
; #3 = 500 - ОБЩЕЕ КОЛИЧЕСТВО ИЗДЕЛИЙ
; Комментарий: number chebur (количество чебурашек)
; Для изменения количества - поменяйте 500 на нужное число
#4=[#11+#7*1.15] ; dlina podachi
; #4 = [25 + 21.0 * 1.15] = 25 + 24.15 = 49.15
; Длина первой подачи проволоки
; Комментарий: длина подачи
#5=[#11+#7*1.45] ;2.00 dlina cheburashki obshay
; #5 = [25 + 21.0 * 1.45] = 25 + 30.45 = 55.45
; Общая длина "чебурашки" (изделия)
; Комментарий: 2.00 длина чебурашки общая
#6=26 ; obrezka
; #6 = 26 - расстояние/позиция для обрезки проволоки
; Комментарий: обрезка
#8=322 ; bolsshoe ushko
; #8 = 322 - угол для формирования большого ушка (в градусах)
; Комментарий: большое ушко
#9=-109 ;ugol 1=-110
; #9 = -109 - первый угол изгиба (в градусах)
; Комментарий: угол 1 (примерно -110)
#10=227 ; poslednij ugol
; #10 = 227 - последний угол изгиба (в градусах)
; Комментарий: последний угол
M9
; M9 - ВЫКЛЮЧИТЬ ОХЛАЖДЕНИЕ (охлаждающую жидкость)
G28
; G28 - ВОЗВРАТ ВСЕХ ОСЕЙ В ДОМАШНЕЕ ПОЛОЖЕНИЕ (ноль)
F4000
; F4000 - УСТАНОВИТЬ СКОРОСТЬ ПОДАЧИ 4000 мм/мин
g92 X0
; G92 X0 - ОБНУЛИТЬ ТЕКУЩУЮ ПОЗИЦИЮ ПО ОСИ X
; (установить текущую позицию X как 0)
G00 Z#1
; G00 - БЫСТРОЕ ПЕРЕМЕЩЕНИЕ (холостой ход)
; Z#1 = Z-17.10 - подвести инструмент к заготовке по оси Z
; (подход на глубину -17.10 мм)
; =====================================================
; НАЧАЛО ЦИКЛА (метка n100)
; =====================================================
n100
; МЕТКА n100 - начало цикла изготовления одного изделия
; Сюда будет переход после каждого изделия (цикл)
g92 X0 Y0
; G92 X0 Y0 - ОБНУЛИТЬ ТЕКУЩИЕ ПОЗИЦИИ ПО ОСЯМ X И Y
; (установить текущие позиции как 0,0)
;#1=[#1+1]
; Закомментированная строка (не выполняется)
; Если раскомментировать: увеличить #1 на 1
m7
; M7 - ВКЛЮЧИТЬ ОХЛАЖДЕНИЕ B (обычно туман)
G00 X#4 ; pervaya protyazka
; G00 - БЫСТРОЕ ПЕРЕМЕЩЕНИЕ
; X#4 = X49.15 - быстрая подача проволоки на длину 49.15 мм
; Комментарий: первая протяжка (первая подача)
m9
; M9 - ВЫКЛЮЧИТЬ ОХЛАЖДЕНИЕ
G04 P0.3
; G04 - ПАУЗА (выдержка времени)
; P0.3 - пауза 0.3 секунды
; (для стабилизации положения)
G01 x[#4+1] Y#9 ;115
; G01 - ЛИНЕЙНОЕ ПЕРЕМЕЩЕНИЕ (рабочая подача)
; X[#4+1] = X[49.15+1] = X50.15
; Y#9 = Y-109 - изгиб проволоки: X=50.15, Y=-109°
; Первый изгиб под углом -109 градусов
; Комментарий: ;115 (пометка)
g04 p0.4
; G04 P0.4 - ПАУЗА 0.4 секунды
g01 y265
; G01 Y265 - ПОВОРОТ НА 265 ГРАДУСОВ
; (формирование следующего изгиба)
g04 p0.6
; G04 P0.6 - ПАУЗА 0.6 секунды
g01 x[#4-3.5] ; bilo 2.5
; G01 X[#4-3.5] = X[49.15-3.5] = X45.65
; Коррекция положения по X
; Комментарий: было 2.5 (раньше было другое значение)
G04 P0.5
; G04 P0.5 - ПАУЗА 0.5 секунды
g01 x[#4+1] y295
; G01 X[#4+1] Y295 = X50.15 Y295
; Поворот на 295 градусов с коррекцией X
G04 P0.5
; G04 P0.5 - ПАУЗА 0.5 секунды
g01 x[#4+6.5] y360
; G01 X[#4+6.5] Y360 = X55.65 Y360
; Полный оборот (360°) с подачей X=55.65
; (завершение первого этапа формирования)
G04 P0.3
; G04 P0.3 - ПАУЗА 0.3 секунды
G00 Z#1
; G00 Z#1 = Z-17.10 - БЫСТРЫЙ ВОЗВРАТ ПО ОСИ Z
; (возврат инструмента на рабочую глубину)
g04 p0.5
; G04 P0.5 - ПАУЗА 0.5 секунды
g01 x[#4+25] y#8; bilo 19
; G01 X[#4+25] Y#8 = X[49.15+25] Y322 = X74.15 Y322
; Формирование большого ушка (угол 322°)
; Комментарий: было 19 (старое значение)
g01 y252 ;292
; G01 Y252 - ПОВОРОТ НА 252 ГРАДУСА
; (продолжение формирования ушка)
; Комментарий: ;292 (пометка)
G04 P0.5
; G04 P0.5 - ПАУЗА 0.5 секунды
M7
; M7 - ВКЛЮЧИТЬ ОХЛАЖДЕНИЕ B
G04 P0.5
; G04 P0.5 - ПАУЗА 0.5 секунды
G00 X[#5*1.77] ;+37 bilo
; G00 - БЫСТРОЕ ПЕРЕМЕЩЕНИЕ
; X[#5*1.77] = X[55.45*1.77] ≈ X98.15
; Быстрый отход по X
; Комментарий: +37 было (старое значение)
g01 y0
; G01 Y0 - ПОВОРОТ В НУЛЕВОЕ ПОЛОЖЕНИЕ (0°)
M9
; M9 - ВЫКЛЮЧИТЬ ОХЛАЖДЕНИЕ
G04 P0.3
; G04 P0.3 - ПАУЗА 0.3 секунды
;G00 X[#5*1.37] ;
; Закомментированная строка (не выполняется)
; G00 X[#5*1.37] ≈ X75.97
G01 Y#10 X[#5*1.74] ;65
; G01 Y#10 X[#5*1.74] = Y227 X[55.45*1.74] ≈ Y227 X96.48
; Последний изгиб под углом 227°
; Комментарий: ;65 (пометка)
G04 P0.3
; G04 P0.3 - ПАУЗА 0.3 секунды
G00 Y180
; G00 Y180 - БЫСТРЫЙ ПОВОРОТ НА 180 ГРАДУСОВ
G00 X[#5*1.90] ; 85
; G00 X[#5*1.90] = X[55.45*1.90] ≈ X105.36
; Быстрое перемещение в конечную позицию X
; Комментарий: ;85 (пометка)
M7
; M7 - ВКЛЮЧИТЬ ОХЛАЖДЕНИЕ B
G04 P0.3
; G04 P0.3 - ПАУЗА 0.3 секунды
G00 X[#5+#6] ;#5+#6
; G00 X[#5+#6] = X[55.45+26] = X81.45
; Позиция для обрезки проволоки
; Комментарий: #5+#6 (формула)
g04 p0.4
; G04 P0.4 - ПАУЗА 0.4 секунды
M3
; M3 - ВКЛЮЧИТЬ ШПИНДЕЛЬ (резак/ножницы)
; (начало обрезки изделия)
G04 P0.5
; G04 P0.5 - ПАУЗА 0.5 секунды
; (время резки/обрезки проволоки)
M5
; M5 - ВЫКЛЮЧИТЬ ШПИНДЕЛЬ (резак)
G04 P0.3
; G04 P0.3 - ПАУЗА 0.3 секунды
G0 Y0
; G0 Y0 - БЫСТРЫЙ ПОВОРОТ В 0 ГРАДУСОВ
; (возврат оси Y в начальное положение)
g92 X0
; G92 X0 - ОБНУЛИТЬ ПОЗИЦИЮ ПО ОСИ X
; (подготовка к следующему циклу)
;M9
; Закомментированная строка (не выполняется)
; M9 - выключить охлаждение
#2=[#2+1]
; #2 = [#2 + 1] - УВЕЛИЧИТЬ СЧЁТЧИК НА 1
; (после первого изделия #2=1, после второго #2=2, и т.д.)
say #2
; SAY #2 - ВЫВЕСТИ ЗНАЧЕНИЕ #2 НА ЭКРАН
; (показывает номер текущего изделия во время выполнения)
if #2 LT #3 m97 o100
; IF #2 LT #3 M97 O100 - УСЛОВНЫЙ ПЕРЕХОД
; "Если #2 МЕНЬШЕ #3, перейти к метке O100"
; #2 - текущий счётчик (начинается с 0)
; #3 = 500 - общее количество изделий
; Если #2 < 500, перейти к метке n100/o100 (начало цикла)
; Если #2 = 500, продолжить выполнение (завершить программу)
M18
; M18 - ВЫКЛЮЧИТЬ ПРИВОДЫ (двигатели осей)
; (выполняется только после 500 изделий)
; =====================================================
; КОНЕЦ ПРОГРАММЫ
; =====================================================
'''r
r
r'M30
; Закомментированные строки (не выполняются)
; M30 - КОНЕЦ ПРОГРАММЫ
; (фактически программа завершается автоматически)
